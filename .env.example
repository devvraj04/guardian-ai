# ==========================================
# GUARDIAN Environment Variables Template
# All secrets must be provided via .env
# Never commit real keys or credentials.
# ==========================================

# Hosted Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=dummy-anon-key-ey...
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key-ey...
DATABASE_URL=postgresql://postgres.your-project-id:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth Verification
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# LLM Configuration (Groq default)
GROQ_API_KEY=gsk_dummy_key_example
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq

# ChromaDB Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Cache & Model Storage Paths
HF_HOME=./hf_cache

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080

# Rate Limiting (SlowAPI)
RATE_LIMIT_PER_MINUTE_AUTH=60
RATE_LIMIT_PER_MINUTE_ANON=10
